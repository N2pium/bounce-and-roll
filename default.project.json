{
  "name": "BounceAndRoll",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "BounceRoll": {
        "$path": "src/shared/BounceRoll",
        "$ignoreUnknownInstances": true,
        "Remotes": {
          "$className": "Folder",
          "BumpRequest": { "$className": "RemoteEvent" },
          "BumpApply": { "$className": "RemoteEvent" },
          "ShowEvent": { "$className": "RemoteEvent" }
        }
      }
    },
    "ServerScriptService": {
      "$path": "src/server"
    },
    "StarterPlayer": {
      "StarterPlayerScripts": {
        "BounceClient": { "$path": "src/client/BounceClient" }
      }
    }
  }
}
